#!/bin/bash
set -euo pipefail

command -v python3 >/dev/null 2>&1 || {
  echo "python3 is required by the demo AMI" >&2
  exit 1
}

install -d -m 0755 /opt/yourclouddude

cat >/opt/yourclouddude/app.py <<'PY'
import socket
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

DB_HOST = "${db_host}"
DB_PORT = ${db_port}


def database_reachable() -> bool:
    try:
        with socket.create_connection((DB_HOST, DB_PORT), timeout=1.5):
            return True
    except OSError:
        return False


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/health":
            payload = b"ok\n"
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
            return

        reachable = database_reachable()
        status = "reachable" if reachable else "not reachable"
        hostname = socket.gethostname()
        body = f"""<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>YourCloudDude Three-Tier Demo</title></head>
<body>
  <h1>YourCloudDude Three-Tier Demo</h1>
  <p>Application instance: <code>{hostname}</code></p>
  <p>RDS network path: <strong>{status}</strong></p>
  <p>The health endpoint checks the web process separately from database reachability.</p>
</body>
</html>
""".encode("utf-8")

        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format, *args):
        return


ThreadingHTTPServer(("0.0.0.0", 8080), Handler).serve_forever()
PY

cat >/etc/systemd/system/yourclouddude-demo.service <<'UNIT'
[Unit]
Description=YourCloudDude three-tier demo web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nobody
WorkingDirectory=/opt/yourclouddude
ExecStart=/usr/bin/python3 /opt/yourclouddude/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
UNIT

chmod 0644 /opt/yourclouddude/app.py
systemctl daemon-reload
systemctl enable --now yourclouddude-demo.service
